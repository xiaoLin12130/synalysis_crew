# 复制为 .env 后填写（.env 已被 gitignore，不会提交）

# LLM 网关（AI 分析用；不填则前端自动降级为规则引擎点评，功能仍可用）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://opencode.ai/zen/go/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# stock_review_crew 分析师 skill 目录（默认 H:\stock_review_crew\skills）
STOCK_REVIEW_CREW_SKILLS_DIR=H:\stock_review_crew\skills

# 分析历史存储目录（默认 data/analyses，已 gitignore）
# SYNALYSIS_DATA_DIR=
